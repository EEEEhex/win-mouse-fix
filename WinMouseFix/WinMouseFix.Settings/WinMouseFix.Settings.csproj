<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <WindowsSdkPackageVersion>10.0.22000.57</WindowsSdkPackageVersion>
    <RootNamespace>WinMouseFix.Settings</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Version>2.1.1</Version>
    <Product>Win Mouse Fix</Product>
    <Company>EEEEhex</Company>
    <Authors>EEEEhex</Authors>
    <Description>Mouse gestures and settings for Win Mouse Fix.</Description>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <ApplicationIcon>..\..\wmf.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\ProductIcon.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
    <Content Include="..\..\wmf.ico" Link="Assets\wmf.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Compile Include="..\Shared\Configuration\ProductConfiguration.cs" Link="Configuration\ProductConfiguration.cs" />
    <Compile Include="..\Shared\Configuration\ProductProtocol.cs" Link="Configuration\ProductProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings.*.json"><WithCulture>false</WithCulture></EmbeddedResource>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
  </ItemGroup>


  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun>False</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
  <!-- Unpackaged XAML/PRI are generated into TargetDir, but this SDK's
       managed publish list omits them. Keep them in the deployment graph. -->
  <Target Name="IncludeUnpackagedXamlResources" AfterTargets="Publish">
    <Error Condition="!Exists('$(TargetDir)$(TargetName).pri')" Text="Application PRI was not generated." />
    <ItemGroup>
      <UnpackagedXaml Include="$(TargetDir)*.xbf;$(TargetDir)$(TargetName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(UnpackagedXaml)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="RequirePortableSettingsDeployment" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(WindowsPackageType)' != 'None' or '$(EnableMsixTooling)' == 'true' or '$(GenerateAppxPackageOnBuild)' == 'true'" Text="WinMouseFix.Settings must use unpackaged, portable deployment. MSIX registration and package generation are disabled." />
  </Target>
</Project>

